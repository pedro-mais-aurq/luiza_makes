# Configuração do backend SQLite local. Copie para .env.local e execute npm run admin:password.
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/luiza.sqlite
ADMIN_PASSWORD_HASH=
# Origens autorizadas, separadas por vírgula. Para Pages, adicione https://SEU-USUARIO.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# Deixe vazio em desenvolvimento: o Vite encaminha /api para o servidor local.
# Na publicação, configure esta URL HTTPS pública na variável VITE_API_URL do repositório.
VITE_API_URL=

# Para usar o backend SQLite em vez da demonstração do navegador:
VITE_STORAGE_MODE=server
